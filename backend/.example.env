# Copy to .env and fill in. For a per-environment override create .env.<NODE_ENV>, e.g. .env.production.
# Precedence: real environment variables > .env.<NODE_ENV> > .env
NODE_ENV=development
APP_PORT=8000

# MySQL. Inside docker-compose the host is the service name "mysql" on 3306; from the host machine
# use 127.0.0.1 on 3308 (the port mapping in docker-compose.yml). User, password and database must
# match the MYSQL_* values in the root env_file.
DB_HOST=mysql
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_DATABASE=database

# Optional
# DB_POOL_SIZE=10    max pooled connections
# MAX_RECORDS=100    upper bound for ?n= on the list endpoints
